# ─────────────────────────────────────────────────────────────────────────────
# Second Brain — environment variables
# Copy this file to .env and fill in the values before running locally or
# deploying to Azure.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Azure: use the connection string from Azure Database for PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/second_brain

# ── OpenAI / Azure OpenAI ─────────────────────────────────────────────────────
# Option A — OpenAI directly:
OPENAI_API_KEY=sk-...

# Option B — Azure OpenAI Service (set both):
# OPENAI_API_KEY=<your-azure-openai-key>
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/

# Option C — Replit AI Integrations proxy (Replit only):
# AI_INTEGRATIONS_OPENAI_API_KEY=...
# AI_INTEGRATIONS_OPENAI_BASE_URL=...

# ── API Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Session secret (used by express-session if added) ─────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example is intentionally kept — it documents required variables

# ── Compiled output ───────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log
pnpm-debug.log*
/libpeerconnection.log
testem.log

# ── Test / coverage ───────────────────────────────────────────────────────────
/coverage/

# ── IDEs and editors ──────────────────────────────────────────────────────────
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── System files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Replit ────────────────────────────────────────────────────────────────────
.cache/
.local/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ── Misc ──────────────────────────────────────────────────────────────────────
/.sass-cache/
/connect.lock
/typings/
